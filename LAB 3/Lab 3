          </tr>
          <tr>
            <td>Machine Learning con Python</td>
            <td>Algoritmos de clasificación.</td>
            <td>Avanzado</td>
          </tr>
          <tr>
            <td>Desarrollo Móvil Nativo</td>
            <td>Creación de apps para iOS y Android.</td>
            <td>Avanzado</td>
          </tr>
        </tbody>
      </table>

    </section>

    <!-- 2. SECCIÓN: TABLA DE PROFESORES -->
    <section id="profesores">
      <h2>Nuestros Docentes</h2>
      
      <table class="data-table">
        <thead>
          <tr>
            <th>Profesor</th>
            <th>Especialidad</th>
            <th>Contacto</th>
          </tr>
        </thead>
        <tbody>
          <tr>
