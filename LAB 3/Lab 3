<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LAB-03 | Plataforma Educativa </title>
  <style>
    /* Colores base: fondo oscuro y texto claro, con acento verde/azul */
    body {
      background-color: rgba(0, 0, 0, 0.623);
      color: #fff;
      font-family: Arial, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    /* Estilos para el Encabezado */
    header {
      background-color: #333;
      padding: 20px;
      text-align: center;
    }

    nav {
      background-color: #444;
      padding: 10px 0;
    }

    nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }

    nav li {
      margin: 0 15px;
      padding: 5px 0;
    }

    /* Color de acento para la navegación */
    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      padding: 5px 10px;
      border-radius: 4px;
      transition: background-color 0.3s;
    }

    nav a:hover {
      background-color: #e8cc10;
      color: #333;
    }

    /* Contenido Principal y Secciones */
    main {
      max-width: 1000px;
      margin: 20px auto;
      gap: 20px;
      padding: 0 20px;
    }

    .form-video-container {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    section {
      background-color: #333;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
      flex: 1;
      min-width: 300px;
      max-width: 500px;
    }

    /* Estilos de formulario */
    .form-group label {
      display: block;
      margin-left: 5px;
      font-weight: bold;
      margin-top: 10px;
    }

    .form-input {
      width: 95%;
      padding: 10px;
      border: 1px solid #0f12ce;
      border-radius: 4px;
      box-sizing: border-box;
      color: #333;
      background-color: #f0f0f0;
    }
 /* Boton de registrar */
    .submit-button {
      padding: 10px 50px;
      border-radius: 15px;
      background-color: #50e390;
      color: #333;
      font-weight: bold;
      border: none;
      cursor: pointer;
      margin-top: 20px;
      transition: all 0.3s ease;
    }
   
    .submit-button:hover {
      background-color: #44aa32;
      transform: scale(1.05);
    }

    fieldset {
      border: 1px solid #555;
      border-radius: 6px;
      padding: 15px;
      margin-bottom: 20px;
    }

    legend {
      color: #50e3c2;
      font-weight: bold;
      padding: 0 10px;
    }

    /* Estilos del video */
    iframe {
      width: 100%;
      max-width: 560px;
      height: 315px;
      border-radius: 8px;
    }

    /* ESTILOS PARA LAS NUEVAS TABLAS DE DATOS */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 0.95em;
    }
    .data-table th, .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #a88383;
      text-align: left;
    }
    .data-table th {
      background-color: #c9b820;
      color: #333;
      font-weight: bold;
    }
    .data-table td a {
      color: #50e3c2;
      text-decoration: none;
    }
    .data-table td a:hover {
      text-decoration: underline;
    }
    .data-table tbody tr:hover {
      background-color: #4e4e4e;
    }
</style>
</head>

<body>

  <!-- encabezado de cuerpo de la pagina-->
  <header>
    <h1>Plataforma Educativa Universidad Central</h1>
  </header>

  <!-- menu -->
  <nav>
    <ul>
      <li><a href="#">Inicio</a></li>
      <li><a href="#cursos">Cursos</a></li>
      <li><a href="#profesores">Profesores</a></li>
      <li><a href="#">Contacto</a></li>
      <li><a href="#">Ayuda</a></li>
    </ul>
  </nav>

  <main class="flex flex-col">
    <!-- CONTENEDOR DE INICIO -->
            <legend>Registro de Usuario</legend>

            <div class="form-group">
              <label for="username">Nombre de Usuario:</label>
              <input class="form-input" type="text" id="username" name="username" required>

              <label for="email">Correo Electrónico:</label>
              <input class="form-input" type="email" id="email" name="email" required>

              <label for="password">Contraseña:</label>
              <input class="form-input" type="password" id="password" name="password" required>
            </div>

            <fieldset>
              <legend>Genero</legend>
              <div>
                <div>
                  <input type="radio" value="m" name="genero" id="g-m">
